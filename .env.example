# Copy to .env.local and fill in.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# public. Anything without that prefix stays on the server — keep secrets and
# the pickup address in that group only.
 
# ---------------------------------------------------------------------------
# Public — safe to expose
# ---------------------------------------------------------------------------

# External booking URL — optional override.
# Leave this BLANK to use the site's own booking form at /book, which is the
# recommended setup: the customer enters everything once and the order arrives
# complete. Set it to a Square booking page and every "Book now" button on the
# site switches to Square instead, with no code changes.
# Example: https://book.squareup.com/appointments/<id>/location/<id>
NEXT_PUBLIC_BOOKING_URL=

# Google Business "write a review" link.
# Powers the Leave a review buttons. Blank falls back to emailing the
# business, so the button is never a dead end.
# Example: https://g.page/r/<place-id>/review
NEXT_PUBLIC_REVIEW_URL=

# ---------------------------------------------------------------------------
# Server only — never sent to the browser
# ---------------------------------------------------------------------------

# Geoapify API key. Powers address autocomplete and the real driving-distance
# lookup behind the pricing calculator.
# Free plan: 3,000 credits/day, no credit card. Sign up at
# https://myprojects.geoapify.com/ and paste the key here.
#
# Leave blank and the calculator still renders, but the address field reports
# that lookup is unavailable and points people at the phone — it never falls
# back to a made-up distance.
GEOAPIFY_API_KEY=

# Coordinates of the home office, used as the start of every route.
# Deliberately NOT public: the business does not publish its street address,
# and the browser only ever receives the resulting mile count.
# Find them by right-clicking the spot in Google Maps and copying the pair,
# or decode a Google Plus Code with: node scripts/decode-pluscode.mjs
# Note the minus sign on the longitude — San Diego is west of Greenwich, and
# dropping it puts the origin on the other side of the planet.
LAUNDRY_ORIGIN_LAT=
LAUNDRY_ORIGIN_LON=

# How far out address suggestions are searched, in miles. Optional.
# Should stay larger than MAX_SERVICE_RADIUS_MILES in src/lib/pricing.ts, so
# people just outside the delivery area still get their address matched and
# can be told plainly that they are out of range. Defaults to 45.
GEO_SEARCH_RADIUS_MILES=

# --- Booking email --------------------------------------------------------
# Orders from /book are delivered by email. Without all three of these the
# booking form reports that online booking is unavailable and points people at
# the phone — an order is never silently accepted and dropped.

# Resend API key. Free plan covers 3,000 emails/month.
# Sign up at https://resend.com/, verify the sending domain, then paste the key.
RESEND_API_KEY=

# Verified sender the confirmation comes from. The domain must be verified in
# Resend or the messages will be rejected.
# Example: California Laundromat <bookings@californialaundromat.com>
ORDER_EMAIL_FROM=

# Where new order tickets are delivered — the inbox that gets worked from.
ORDER_EMAIL_TO=
